  "arcadeEnabled": true,
  "expression": "function Col(opciones) {\n  for (var i in opciones) {\n    if (HasKey($datapoint, opciones[i])) { return opciones[i]; }\n  }\n  return opciones[0];\n}\n\nfunction Num(campo) {\n  var v = $datapoint[campo];\n  return IIf(IsEmpty(v), 0, Number(v));\n}\n\nvar agrupada = !HasKey($datapoint, 'EVENTO');\n\nvar COL_EVENTO = IIf(agrupada, 'CLAVE', 'EVENTO');\nvar COL_2025   = Col(['sum_A_2025', 'A_2025', 'A_2025_sum', 'SUM_A_2025']);\nvar COL_2026   = Col(['sum_A_2026', 'A_2026', 'A_2026_sum', 'SUM_A_2026']);\nvar COL_DIF    = Col(['sum_DIFERENCIA', 'DIFERENCIA', 'DIFERENCIA_sum', 'SUM_DIFERENCIA']);\nvar COL_PCT    = Col(['sum_PORCENTAJE', 'PORCENTAJE', 'PORCENTAJE_sum', 'SUM_PORCENTAJE']);\nvar ETIQUETA_TOTAL = 'TOTAL COMBATES';\n\nvar etiqueta = '';\nif (agrupada) {\n  var partes = Split(Text($datapoint[COL_EVENTO]), '|');\n  etiqueta = IIf(Count(partes) > 1, partes[1], '');\n} else {\n  etiqueta = IIf(IsEmpty($datapoint.EVENTO), '', $datapoint.EVENTO);\n}\n\nvar blanco  = etiqueta == '';\nvar esTotal = etiqueta == ETIQUETA_TOTAL;\n\nvar v1  = Num(COL_2025);\nvar v2  = Num(COL_2026);\nvar dif = v2 - v1;\n\nvar pct = '';\nif (v1 == 0 && v2 == 0) { pct = '0 %'; }\nelse if (v1 == 0)       { pct = 'N/A'; }\nelse                    { pct = Text(Round(dif / v1 * 100, 0)) + ' %'; }\n\nvar rojo  = IIf(dif < 0, '#C00000', '');\nvar fondo = IIf(esTotal, '#D9D9D9', '');\n\nfunction Celda(texto, color, alin) {\n  return {\n    displayText: IIf(blanco, '', texto),\n    textColor: color,\n    backgroundColor: fondo,\n    textAlign: alin,\n    iconName: '',\n    iconAlign: '',\n    iconColor: '',\n    iconOutlineColor: ''\n  };\n}\n\nvar cells = {};\ncells[COL_EVENTO] = Celda(etiqueta, '', 'left');\ncells[COL_2025]   = Celda(Text(v1, '#,##0'), '', 'center');\ncells[COL_2026]   = Celda(Text(v2, '#,##0'), '', 'center');\ncells[COL_DIF]    = Celda(Text(dif, '#,##0'), rojo, 'center');\ncells[COL_PCT]    = Celda(pct, rojo, 'center');\n\nreturn { cells: cells };\n",
