"arcadeDataSourceItems": [
    {
        "type": "arcadeItem",
        "itemId": "9a8b8c82-15ed-4b71-8eb7-6b4254e523ec",
        "name": "Resultados",
        "script": "// =====================================================================\n//  CONFIGURACIÓN GENERAL\n// =====================================================================\nvar PORTAL_URL  = 'https://portalgis.ejercito.mil.co/portal';\nvar ANIO_1      = 2025;\nvar ANIO_2      = 2026;\nvar CAMPO_FECHA = 'FECHA_HECHO';\n\n// Campos por los que llegan los filtros del tablero (deben existir en todas las capas).\n// DIVISION debe ir de primera.\nvar DIMENSIONES = ['DIVISION', 'BRIGADA', 'DEPARTAMENTO', 'D_AMENAZA', 'LINEA_OPERACION'];\n\n// true = la tabla muestra sus filas en 0 cuando el filtro no tiene datos\nvar RELLENAR_CEROS = true;\n\n// Utilidades para armar los filtros SQL (no modificar)\nfunction SqlValor(v) {\n  if (TypeOf(v) == 'Number') { return Text(v); }\n  return \"'\" + Replace(Text(v), \"'\", \"''\") + \"'\";\n}\nfunction SqlLista(valores) {\n  var s = '';\n  for (var i in valores) { s += IIf(s == '', '', ',') + SqlValor(valores[i]); }\n  return '(' + s + ')';\n}\n\n// =====================================================================\n//  CONFIGURACIÓN DE LA TABLA: RESULTADOS\n// =====================================================================\nvar INCLUIR_TOTAL       = true;\nvar ETIQUETA_TOTAL      = 'TOTAL AFECTACIÓN';\nvar INCLUIR_FILA_BLANCO = true;\n\nvar AMENAZAS_MDOM = [\n  'GAO-ELN',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO CAPARROS',\n  'GAO COMUNEROS DEL SUR',\n  'FARC',\n  'GAO-r SM Facción Iván Márquez',\n  'DELINCUENCIA',\n  'ERG',\n  'GAO PELUSOS',\n  'GDO',\n  'EPL',\n  'GAO',\n  'NARCOTRÁFICO',\n  'GAO - Residual Disidencias FARC',\n  'ERP',\n  'GAO-r EMC Facción Iván Mordisco',\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO-RESIDUAL',\n  'BACRIM',\n  'GAO-r SM-CNEB Facción Walter Mendoza'\n];\n\nvar AMENAZAS_CAPTURAS = [\n  'DELINCUENCIA COMÚN',\n  'GAO-ELN',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO COMUNEROS DEL SUR',\n  'GAO-r SM Facción Iván Márquez',\n  'DELINCUENCIA',\n  'GDO',\n  'GAO',\n  'NARCOTRÁFICO',\n  'GAO-r EMC Facción Iván Mordisco',\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO - Residual Disidencias FARC',\n  'GAO-r SM-CNEB Facción Walter Mendoza',\n  'Delincuencia Organizada Transnacional',\n  'GAO-RESIDUAL'\n];\n\nvar AMENAZAS_SOMETIDOS = [\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO-ELN',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO COMUNEROS DEL SUR',\n  'GAO-r SM Facción Iván Márquez',\n  'GDO',\n  'GAO-r EMC Facción Iván Mordisco',\n  'GAO - Residual Disidencias FARC',\n  'GAO-r SM-CNEB Facción Walter Mendoza',\n  'GAO-RESIDUAL'\n];\n\nvar AMENAZAS_RME = [\n  'GAO COMUNEROS DEL SUR',\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO-ELN',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO-r SM Facción Iván Márquez',\n  'DELINCUENCIA',\n  'GDO',\n  'NARCOTRÁFICO',\n  'GAO - Residual Disidencias FARC',\n  'GAO-r EMC Facción Iván Mordisco',\n  'GAO-RESIDUAL',\n  'Delincuencia Organizada Transnacional',\n  'GAO-r SM-CNEB Facción Walter Mendoza'\n];\n\nvar CLASES_MDOM = ['GAO-R', 'BDSN', 'FARC', 'DELINCUENCIA COMÚN', 'ELN', 'ERG', 'GAO', 'GDO',\n                   'EPL', 'NARCOTRAFICO', 'ERP', 'GAO-RESIDUAL'];\nvar SUBTIPOS_EXCLUIDOS_MDOM = ['CANINOS', 'SEMOVIENTES', 'SOLDADOS', 'SUBOFICIALES', 'OFICIALES'];\nvar SUBTIPOS_PERSONAS = ['TERRORISTAS', 'NARCOTRAFICANTES', 'DELINCUENTES'];\n\nvar BASE_PERSONAS = \"PROPIAS_TROPAS = 'N' AND TIPO IN ('PERSONAS') AND SUBTIPO IN \" + SqlLista(SUBTIPOS_PERSONAS);\n\nvar FILAS = [\n  { etiqueta: 'M. D. O. M', itemId: '3df1e55fdf6345c4a7fc4c61cfbe9f8b', layerId: 0, operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    where: \"PROPIAS_TROPAS = 'N' AND D_AMENAZA IN \" + SqlLista(AMENAZAS_MDOM) +\n           ' AND CLASE IN ' + SqlLista(CLASES_MDOM) +\n           ' AND SUBTIPO NOT IN ' + SqlLista(SUBTIPOS_EXCLUIDOS_MDOM) },\n  { etiqueta: 'Capturas',   itemId: '03d84fbdf68e4f2fbb67cbd3341830f1', layerId: 2, operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    where: BASE_PERSONAS + ' AND D_AMENAZA IN ' + SqlLista(AMENAZAS_CAPTURAS) },\n  { etiqueta: 'Sometidos',  itemId: '3b82c922e2ed4385a9680a1d4bf4144f', layerId: 0, operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    where: BASE_PERSONAS + ' AND D_AMENAZA IN ' + SqlLista(AMENAZAS_SOMETIDOS) },\n  { etiqueta: 'R M E',      itemId: '1df585d1105c4a6eb2e1c4ec8c132042', layerId: 0, operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    where: BASE_PERSONAS + ' AND D_AMENAZA IN ' + SqlLista(AMENAZAS_RME) }\n];\n\n// =====================================================================\n//  MOTOR: no modificar debajo de esta línea\n// =====================================================================\nvar portalObj = Portal(PORTAL_URL);\nvar SEP = '¦';\n\nfunction WhereRango(desde, hasta) {\n  return CAMPO_FECHA + \" >= DATE '\" + Text(desde) + \"-01-01' AND \" +\n         CAMPO_FECHA + \" < DATE '\"  + Text(hasta + 1) + \"-01-01'\";\n}\n\nfunction TextoDim(v) {\n  if (IsEmpty(v)) { return ''; }\n  return Text(v);\n}\n\nfunction UnirLlave(vals) {\n  var s = '';\n  for (var i in vals) { s += IIf(i == 0, '', SEP) + vals[i]; }\n  return s;\n}\n\nfunction Vacios() {\n  var v = [];\n  for (var i in DIMENSIONES) { Push(v, ''); }\n  return v;\n}\n\n// llave -> [valores de las dimensiones]\nvar grupos = {};\n\nfunction Registrar(vals) {\n  var ll = UnirLlave(vals);\n  if (!HasKey(grupos, ll)) { grupos[ll] = vals; }\n}\n\n// Suma (o conteo) de una fila en un año, agrupada por todas las dimensiones\nfunction Medir(fila, anio) {\n  var capa  = FeatureSetByPortalItem(portalObj, fila.itemId, fila.layerId, ['*'], false);\n  var where = '(' + fila.where + ') AND (' + WhereRango(anio, anio) + ')';\n  var expr  = IIf(fila.operacion == 'SUMA', fila.campoSuma, '1');\n  var est   = IIf(fila.operacion == 'SUMA', 'SUM', 'COUNT');\n  var g = GroupBy(Filter(capa, where), DIMENSIONES,\n                  [{ name: 'TOTAL_CANT', expression: expr, statistic: est }]);\n  var res = {};\n  var total = 0;\n  for (var r in g) {\n    var vals = [];\n    for (var i in DIMENSIONES) { Push(vals, TextoDim(r[DIMENSIONES[i]])); }\n    var ll = UnirLlave(vals);\n    var cant = 0;\n    if (!IsEmpty(r.TOTAL_CANT)) { cant = r.TOTAL_CANT; }\n    if (HasKey(res, ll)) { res[ll] = res[ll] + cant; } else { res[ll] = cant; }\n    total += cant;\n    Registrar(vals);\n  }\n  Console(fila.etiqueta + ' ' + Text(anio) + ': ' + Text(total));\n  return res;\n}\n\n// Grupos en cero para que la tabla nunca quede \"Sin datos\"\nvar capasVistas = {};\nfunction Rellenar(itemId, layerId) {\n  var id = itemId + '_' + Text(layerId);\n  if (HasKey(capasVistas, id)) { return; }\n  capasVistas[id] = true;\n  var capa = FeatureSetByPortalItem(portalObj, itemId, layerId, ['*'], false);\n\n  // 1) Cada valor de cada dimensión (todo el histórico de la capa)\n  for (var j in DIMENSIONES) {\n    for (var d in Distinct(capa, DIMENSIONES[j])) {\n      var x = TextoDim(d[DIMENSIONES[j]]);\n      if (x == '') { continue; }\n      var v = Vacios();\n      v[j] = x;\n      Registrar(v);\n    }\n  }\n\n  // 2) DIVISION + cada una de las otras dimensiones (periodo analizado)\n  var periodo = Filter(capa, WhereRango(ANIO_1, ANIO_2));\n  for (var j2 in DIMENSIONES) {\n    if (j2 == 0) { continue; }\n    for (var d2 in Distinct(periodo, [DIMENSIONES[0], DIMENSIONES[j2]])) {\n      var a = TextoDim(d2[DIMENSIONES[0]]);\n      var b = TextoDim(d2[DIMENSIONES[j2]]);\n      if (a == '' || b == '') { continue; }\n      var v2 = Vacios();\n      v2[0]  = a;\n      v2[j2] = b;\n      Registrar(v2);\n    }\n  }\n}\n\nfunction ValorDe(dic, ll) {\n  if (!HasKey(dic, ll)) { return 0; }\n  return dic[ll];\n}\n\n// 0 y 0 -> 0 %; 0 y >0 -> N/A; resto -> cálculo normal\nfunction Porcentaje(a1, a2) {\n  if (a1 == 0 && a2 == 0) { return 0; }\n  if (a1 == 0) { return null; }\n  return Round((a2 - a1) / a1 * 100, 0);\n}\n\nfunction Clave(n, texto) { return Text(n, '00') + '|' + texto; }\n\nvar medidas = [];\nfor (var k in FILAS) {\n  Push(medidas, { a1: Medir(FILAS[k], ANIO_1), a2: Medir(FILAS[k], ANIO_2) });\n}\nif (RELLENAR_CEROS) {\n  for (var k2 in FILAS) { Rellenar(FILAS[k2].itemId, FILAS[k2].layerId); }\n}\n\nvar nombre1 = 'A_' + Text(ANIO_1);\nvar nombre2 = 'A_' + Text(ANIO_2);\nvar features = [];\n\nfunction Agregar(vals, cv, texto, v1, v2) {\n  var attr = { CLAVE: cv, EVENTO: texto,\n               DIFERENCIA: v2 - v1, PORCENTAJE: Porcentaje(v1, v2) };\n  for (var i in DIMENSIONES) { attr[DIMENSIONES[i]] = IIf(vals[i] == '', null, vals[i]); }\n  attr[nombre1] = v1;\n  attr[nombre2] = v2;\n  Push(features, { attributes: attr });\n}\n\nfor (var ll in grupos) {\n  var vals = grupos[ll];\n  var t1 = 0;\n  var t2 = 0;\n  for (var k3 in FILAS) {\n    var v1 = ValorDe(medidas[k3].a1, ll);\n    var v2 = ValorDe(medidas[k3].a2, ll);\n    t1 += v1;\n    t2 += v2;\n    Agregar(vals, Clave(k3 + 1, FILAS[k3].etiqueta), FILAS[k3].etiqueta, v1, v2);\n  }\n  if (INCLUIR_TOTAL)       { Agregar(vals, Clave(98, ETIQUETA_TOTAL), ETIQUETA_TOTAL, t1, t2); }\n  if (INCLUIR_FILA_BLANCO) { Agregar(vals, Clave(99, ''), '', 0, 0); }\n}\nConsole('Filas generadas: ' + Text(Count(features)));\n\nvar camposSalida = [];\nfor (var i in DIMENSIONES) { Push(camposSalida, { name: DIMENSIONES[i], type: 'esriFieldTypeString' }); }\nPush(camposSalida, { name: 'CLAVE',      type: 'esriFieldTypeString' });\nPush(camposSalida, { name: 'EVENTO',     type: 'esriFieldTypeString' });\nPush(camposSalida, { name: nombre1,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: nombre2,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'DIFERENCIA', type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'PORCENTAJE', type: 'esriFieldTypeDouble' });\n\nreturn FeatureSet(Text({ fields: camposSalida, geometryType: '', features: features }));",
        "refreshInterval": 180
    },
    {
        "type": "arcadeItem",
        "itemId": "81535e44-588a-49c7-a168-9389757b599e",
        "name": "COMBATES",
        "script": "// =====================================================================\n//  CONFIGURACIÓN GENERAL\n// =====================================================================\nvar PORTAL_URL  = 'https://portalgis.ejercito.mil.co/portal';\nvar ANIO_1      = 2025;\nvar ANIO_2      = 2026;\nvar CAMPO_FECHA = 'FECHA_HECHO';\n\n// Campos por los que llegan los filtros del tablero (deben existir en todas las capas).\n// DIVISION debe ir de primera.\nvar DIMENSIONES = ['DIVISION', 'BRIGADA', 'DEPARTAMENTO', 'D_AMENAZA', 'LINEA_OPERACION'];\n\n// true = la tabla muestra sus filas en 0 cuando el filtro no tiene datos\nvar RELLENAR_CEROS = true;\n\n// Utilidades para armar los filtros SQL (no modificar)\nfunction SqlValor(v) {\n  if (TypeOf(v) == 'Number') { return Text(v); }\n  return \"'\" + Replace(Text(v), \"'\", \"''\") + \"'\";\n}\nfunction SqlLista(valores) {\n  var s = '';\n  for (var i in valores) { s += IIf(s == '', '', ',') + SqlValor(valores[i]); }\n  return '(' + s + ')';\n}\n\n// =====================================================================\n//  CONFIGURACIÓN DE LA TABLA: COMBATES\n// =====================================================================\nvar ITEM_ID     = '26c3f7e3294f4d02a740f9d4ded9eb0a';\nvar LAYER_ID    = 1;\nvar FILTRO_BASE = '1=1';\n\nvar INCLUIR_TOTAL       = true;\nvar ETIQUETA_TOTAL      = 'TOTAL COMBATES';\nvar INCLUIR_FILA_BLANCO = true;\n\n// operacion: 'CONTEO' (cuenta registros) o 'SUMA' (suma campoSuma)\nvar FILAS = [\n  { etiqueta: 'POSITIVOS',      itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'CONTEO', campoSuma: '',\n    where: '(' + FILTRO_BASE + \") AND HECHO_P IN ('P')\" },\n  { etiqueta: 'NEGATIVOS',      itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'CONTEO', campoSuma: '',\n    where: '(' + FILTRO_BASE + \") AND HECHO_P IN ('N')\" },\n  { etiqueta: 'SIN RESULTADOS', itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'CONTEO', campoSuma: '',\n    where: '(' + FILTRO_BASE + \") AND HECHO_P IN ('SR')\" }\n];\n\n// =====================================================================\n//  MOTOR: no modificar debajo de esta línea\n// =====================================================================\nvar portalObj = Portal(PORTAL_URL);\nvar SEP = '¦';\n\nfunction WhereRango(desde, hasta) {\n  return CAMPO_FECHA + \" >= DATE '\" + Text(desde) + \"-01-01' AND \" +\n         CAMPO_FECHA + \" < DATE '\"  + Text(hasta + 1) + \"-01-01'\";\n}\n\nfunction TextoDim(v) {\n  if (IsEmpty(v)) { return ''; }\n  return Text(v);\n}\n\nfunction UnirLlave(vals) {\n  var s = '';\n  for (var i in vals) { s += IIf(i == 0, '', SEP) + vals[i]; }\n  return s;\n}\n\nfunction Vacios() {\n  var v = [];\n  for (var i in DIMENSIONES) { Push(v, ''); }\n  return v;\n}\n\n// llave -> [valores de las dimensiones]\nvar grupos = {};\n\nfunction Registrar(vals) {\n  var ll = UnirLlave(vals);\n  if (!HasKey(grupos, ll)) { grupos[ll] = vals; }\n}\n\n// Suma (o conteo) de una fila en un año, agrupada por todas las dimensiones\nfunction Medir(fila, anio) {\n  var capa  = FeatureSetByPortalItem(portalObj, fila.itemId, fila.layerId, ['*'], false);\n  var where = '(' + fila.where + ') AND (' + WhereRango(anio, anio) + ')';\n  var expr  = IIf(fila.operacion == 'SUMA', fila.campoSuma, '1');\n  var est   = IIf(fila.operacion == 'SUMA', 'SUM', 'COUNT');\n  var g = GroupBy(Filter(capa, where), DIMENSIONES,\n                  [{ name: 'TOTAL_CANT', expression: expr, statistic: est }]);\n  var res = {};\n  var total = 0;\n  for (var r in g) {\n    var vals = [];\n    for (var i in DIMENSIONES) { Push(vals, TextoDim(r[DIMENSIONES[i]])); }\n    var ll = UnirLlave(vals);\n    var cant = 0;\n    if (!IsEmpty(r.TOTAL_CANT)) { cant = r.TOTAL_CANT; }\n    if (HasKey(res, ll)) { res[ll] = res[ll] + cant; } else { res[ll] = cant; }\n    total += cant;\n    Registrar(vals);\n  }\n  Console(fila.etiqueta + ' ' + Text(anio) + ': ' + Text(total));\n  return res;\n}\n\n// Grupos en cero para que la tabla nunca quede \"Sin datos\"\nvar capasVistas = {};\nfunction Rellenar(itemId, layerId) {\n  var id = itemId + '_' + Text(layerId);\n  if (HasKey(capasVistas, id)) { return; }\n  capasVistas[id] = true;\n  var capa = FeatureSetByPortalItem(portalObj, itemId, layerId, ['*'], false);\n\n  // 1) Cada valor de cada dimensión (todo el histórico de la capa)\n  for (var j in DIMENSIONES) {\n    for (var d in Distinct(capa, DIMENSIONES[j])) {\n      var x = TextoDim(d[DIMENSIONES[j]]);\n      if (x == '') { continue; }\n      var v = Vacios();\n      v[j] = x;\n      Registrar(v);\n    }\n  }\n\n  // 2) DIVISION + cada una de las otras dimensiones (periodo analizado)\n  var periodo = Filter(capa, WhereRango(ANIO_1, ANIO_2));\n  for (var j2 in DIMENSIONES) {\n    if (j2 == 0) { continue; }\n    for (var d2 in Distinct(periodo, [DIMENSIONES[0], DIMENSIONES[j2]])) {\n      var a = TextoDim(d2[DIMENSIONES[0]]);\n      var b = TextoDim(d2[DIMENSIONES[j2]]);\n      if (a == '' || b == '') { continue; }\n      var v2 = Vacios();\n      v2[0]  = a;\n      v2[j2] = b;\n      Registrar(v2);\n    }\n  }\n}\n\nfunction ValorDe(dic, ll) {\n  if (!HasKey(dic, ll)) { return 0; }\n  return dic[ll];\n}\n\n// 0 y 0 -> 0 %; 0 y >0 -> N/A; resto -> cálculo normal\nfunction Porcentaje(a1, a2) {\n  if (a1 == 0 && a2 == 0) { return 0; }\n  if (a1 == 0) { return null; }\n  return Round((a2 - a1) / a1 * 100, 0);\n}\n\nfunction Clave(n, texto) { return Text(n, '00') + '|' + texto; }\n\nvar medidas = [];\nfor (var k in FILAS) {\n  Push(medidas, { a1: Medir(FILAS[k], ANIO_1), a2: Medir(FILAS[k], ANIO_2) });\n}\nif (RELLENAR_CEROS) {\n  for (var k2 in FILAS) { Rellenar(FILAS[k2].itemId, FILAS[k2].layerId); }\n}\n\nvar nombre1 = 'A_' + Text(ANIO_1);\nvar nombre2 = 'A_' + Text(ANIO_2);\nvar features = [];\n\nfunction Agregar(vals, cv, texto, v1, v2) {\n  var attr = { CLAVE: cv, EVENTO: texto,\n               DIFERENCIA: v2 - v1, PORCENTAJE: Porcentaje(v1, v2) };\n  for (var i in DIMENSIONES) { attr[DIMENSIONES[i]] = IIf(vals[i] == '', null, vals[i]); }\n  attr[nombre1] = v1;\n  attr[nombre2] = v2;\n  Push(features, { attributes: attr });\n}\n\nfor (var ll in grupos) {\n  var vals = grupos[ll];\n  var t1 = 0;\n  var t2 = 0;\n  for (var k3 in FILAS) {\n    var v1 = ValorDe(medidas[k3].a1, ll);\n    var v2 = ValorDe(medidas[k3].a2, ll);\n    t1 += v1;\n    t2 += v2;\n    Agregar(vals, Clave(k3 + 1, FILAS[k3].etiqueta), FILAS[k3].etiqueta, v1, v2);\n  }\n  if (INCLUIR_TOTAL)       { Agregar(vals, Clave(98, ETIQUETA_TOTAL), ETIQUETA_TOTAL, t1, t2); }\n  if (INCLUIR_FILA_BLANCO) { Agregar(vals, Clave(99, ''), '', 0, 0); }\n}\nConsole('Filas generadas: ' + Text(Count(features)));\n\nvar camposSalida = [];\nfor (var i in DIMENSIONES) { Push(camposSalida, { name: DIMENSIONES[i], type: 'esriFieldTypeString' }); }\nPush(camposSalida, { name: 'CLAVE',      type: 'esriFieldTypeString' });\nPush(camposSalida, { name: 'EVENTO',     type: 'esriFieldTypeString' });\nPush(camposSalida, { name: nombre1,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: nombre2,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'DIFERENCIA', type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'PORCENTAJE', type: 'esriFieldTypeDouble' });\n\nreturn FeatureSet(Text({ fields: camposSalida, geometryType: '', features: features }));",
        "refreshInterval": 0
    },
    {
        "type": "arcadeItem",
        "itemId": "f7d798cc-b81d-4624-8f6b-8c0defc8df39",
        "name": "Narcotrafico",
        "script": "// =====================================================================\n//  CONFIGURACIÓN GENERAL\n// =====================================================================\nvar PORTAL_URL  = 'https://portalgis.ejercito.mil.co/portal';\nvar ANIO_1      = 2025;\nvar ANIO_2      = 2026;\nvar CAMPO_FECHA = 'FECHA_HECHO';\n\n// Campos por los que llegan los filtros del tablero (deben existir en todas las capas).\n// DIVISION debe ir de primera.\nvar DIMENSIONES = ['DIVISION', 'BRIGADA', 'DEPARTAMENTO', 'D_AMENAZA', 'LINEA_OPERACION'];\n\n// true = la tabla muestra sus filas en 0 cuando el filtro no tiene datos\nvar RELLENAR_CEROS = true;\n\n// Utilidades para armar los filtros SQL (no modificar)\nfunction SqlValor(v) {\n  if (TypeOf(v) == 'Number') { return Text(v); }\n  return \"'\" + Replace(Text(v), \"'\", \"''\") + \"'\";\n}\nfunction SqlLista(valores) {\n  var s = '';\n  for (var i in valores) { s += IIf(s == '', '', ',') + SqlValor(valores[i]); }\n  return '(' + s + ')';\n}\n\n// =====================================================================\n//  CONFIGURACIÓN DE LA TABLA: NARCOTRÁFICO\n// =====================================================================\nvar ITEM_ID     = 'feb1a5a36e874eb7a663b58503716856';\nvar LAYER_ID    = 0;\nvar FILTRO_BASE = '1=1';\n\nvar INCLUIR_TOTAL       = false;     // mezcla unidades (kg y laboratorios)\nvar ETIQUETA_TOTAL      = 'TOTAL';\nvar INCLUIR_FILA_BLANCO = true;\n\n// Cada fila = suma de una columna (los laboratorios están cruzados en la capa)\nvar FILAS = [\n  { etiqueta: 'COCAÍNA',                            itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'COCAINA',                            where: FILTRO_BASE },\n  { etiqueta: 'PASTA DE COCA',                      itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'PASTA_DE_COCA',                      where: FILTRO_BASE },\n  { etiqueta: 'MARIHUANA',                          itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'MARIHUANA',                          where: FILTRO_BASE },\n  { etiqueta: 'LABORATORIO CLORHIDRATO DE COCAÍNA', itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'LABORATORIO_PASTA_O_BASE_DE_COCA',   where: FILTRO_BASE },\n  { etiqueta: 'LABORATORIO PASTA O BASE DE COCA',   itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'LABORATORIO_CLORHIDRATO_DE_COCAINA', where: FILTRO_BASE }\n];\n\n// =====================================================================\n//  MOTOR: no modificar debajo de esta línea\n// =====================================================================\nvar portalObj = Portal(PORTAL_URL);\nvar SEP = '¦';\n\nfunction WhereRango(desde, hasta) {\n  return CAMPO_FECHA + \" >= DATE '\" + Text(desde) + \"-01-01' AND \" +\n         CAMPO_FECHA + \" < DATE '\"  + Text(hasta + 1) + \"-01-01'\";\n}\n\nfunction TextoDim(v) {\n  if (IsEmpty(v)) { return ''; }\n  return Text(v);\n}\n\nfunction UnirLlave(vals) {\n  var s = '';\n  for (var i in vals) { s += IIf(i == 0, '', SEP) + vals[i]; }\n  return s;\n}\n\nfunction Vacios() {\n  var v = [];\n  for (var i in DIMENSIONES) { Push(v, ''); }\n  return v;\n}\n\n// llave -> [valores de las dimensiones]\nvar grupos = {};\n\nfunction Registrar(vals) {\n  var ll = UnirLlave(vals);\n  if (!HasKey(grupos, ll)) { grupos[ll] = vals; }\n}\n\n// Suma (o conteo) de una fila en un año, agrupada por todas las dimensiones\nfunction Medir(fila, anio) {\n  var capa  = FeatureSetByPortalItem(portalObj, fila.itemId, fila.layerId, ['*'], false);\n  var where = '(' + fila.where + ') AND (' + WhereRango(anio, anio) + ')';\n  var expr  = IIf(fila.operacion == 'SUMA', fila.campoSuma, '1');\n  var est   = IIf(fila.operacion == 'SUMA', 'SUM', 'COUNT');\n  var g = GroupBy(Filter(capa, where), DIMENSIONES,\n                  [{ name: 'TOTAL_CANT', expression: expr, statistic: est }]);\n  var res = {};\n  var total = 0;\n  for (var r in g) {\n    var vals = [];\n    for (var i in DIMENSIONES) { Push(vals, TextoDim(r[DIMENSIONES[i]])); }\n    var ll = UnirLlave(vals);\n    var cant = 0;\n    if (!IsEmpty(r.TOTAL_CANT)) { cant = r.TOTAL_CANT; }\n    if (HasKey(res, ll)) { res[ll] = res[ll] + cant; } else { res[ll] = cant; }\n    total += cant;\n    Registrar(vals);\n  }\n  Console(fila.etiqueta + ' ' + Text(anio) + ': ' + Text(total));\n  return res;\n}\n\n// Grupos en cero para que la tabla nunca quede \"Sin datos\"\nvar capasVistas = {};\nfunction Rellenar(itemId, layerId) {\n  var id = itemId + '_' + Text(layerId);\n  if (HasKey(capasVistas, id)) { return; }\n  capasVistas[id] = true;\n  var capa = FeatureSetByPortalItem(portalObj, itemId, layerId, ['*'], false);\n\n  // 1) Cada valor de cada dimensión (todo el histórico de la capa)\n  for (var j in DIMENSIONES) {\n    for (var d in Distinct(capa, DIMENSIONES[j])) {\n      var x = TextoDim(d[DIMENSIONES[j]]);\n      if (x == '') { continue; }\n      var v = Vacios();\n      v[j] = x;\n      Registrar(v);\n    }\n  }\n\n  // 2) DIVISION + cada una de las otras dimensiones (periodo analizado)\n  var periodo = Filter(capa, WhereRango(ANIO_1, ANIO_2));\n  for (var j2 in DIMENSIONES) {\n    if (j2 == 0) { continue; }\n    for (var d2 in Distinct(periodo, [DIMENSIONES[0], DIMENSIONES[j2]])) {\n      var a = TextoDim(d2[DIMENSIONES[0]]);\n      var b = TextoDim(d2[DIMENSIONES[j2]]);\n      if (a == '' || b == '') { continue; }\n      var v2 = Vacios();\n      v2[0]  = a;\n      v2[j2] = b;\n      Registrar(v2);\n    }\n  }\n}\n\nfunction ValorDe(dic, ll) {\n  if (!HasKey(dic, ll)) { return 0; }\n  return dic[ll];\n}\n\n// 0 y 0 -> 0 %; 0 y >0 -> N/A; resto -> cálculo normal\nfunction Porcentaje(a1, a2) {\n  if (a1 == 0 && a2 == 0) { return 0; }\n  if (a1 == 0) { return null; }\n  return Round((a2 - a1) / a1 * 100, 0);\n}\n\nfunction Clave(n, texto) { return Text(n, '00') + '|' + texto; }\n\nvar medidas = [];\nfor (var k in FILAS) {\n  Push(medidas, { a1: Medir(FILAS[k], ANIO_1), a2: Medir(FILAS[k], ANIO_2) });\n}\nif (RELLENAR_CEROS) {\n  for (var k2 in FILAS) { Rellenar(FILAS[k2].itemId, FILAS[k2].layerId); }\n}\n\nvar nombre1 = 'A_' + Text(ANIO_1);\nvar nombre2 = 'A_' + Text(ANIO_2);\nvar features = [];\n\nfunction Agregar(vals, cv, texto, v1, v2) {\n  var attr = { CLAVE: cv, EVENTO: texto,\n               DIFERENCIA: v2 - v1, PORCENTAJE: Porcentaje(v1, v2) };\n  for (var i in DIMENSIONES) { attr[DIMENSIONES[i]] = IIf(vals[i] == '', null, vals[i]); }\n  attr[nombre1] = v1;\n  attr[nombre2] = v2;\n  Push(features, { attributes: attr });\n}\n\nfor (var ll in grupos) {\n  var vals = grupos[ll];\n  var t1 = 0;\n  var t2 = 0;\n  for (var k3 in FILAS) {\n    var v1 = ValorDe(medidas[k3].a1, ll);\n    var v2 = ValorDe(medidas[k3].a2, ll);\n    t1 += v1;\n    t2 += v2;\n    Agregar(vals, Clave(k3 + 1, FILAS[k3].etiqueta), FILAS[k3].etiqueta, v1, v2);\n  }\n  if (INCLUIR_TOTAL)       { Agregar(vals, Clave(98, ETIQUETA_TOTAL), ETIQUETA_TOTAL, t1, t2); }\n  if (INCLUIR_FILA_BLANCO) { Agregar(vals, Clave(99, ''), '', 0, 0); }\n}\nConsole('Filas generadas: ' + Text(Count(features)));\n\nvar camposSalida = [];\nfor (var i in DIMENSIONES) { Push(camposSalida, { name: DIMENSIONES[i], type: 'esriFieldTypeString' }); }\nPush(camposSalida, { name: 'CLAVE',      type: 'esriFieldTypeString' });\nPush(camposSalida, { name: 'EVENTO',     type: 'esriFieldTypeString' });\nPush(camposSalida, { name: nombre1,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: nombre2,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'DIFERENCIA', type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'PORCENTAJE', type: 'esriFieldTypeDouble' });\n\nreturn FeatureSet(Text({ fields: camposSalida, geometryType: '', features: features }));",
        "refreshInterval": 180
    },
