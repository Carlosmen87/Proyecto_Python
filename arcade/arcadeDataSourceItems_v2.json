        "name": "Mineria Ilegal",
        "script": "// =====================================================================\n//  CONFIGURACIÓN GENERAL\n// =====================================================================\nvar PORTAL_URL  = 'https://portalgis.ejercito.mil.co/portal';\nvar ANIO_1      = 2025;\nvar ANIO_2      = 2026;\nvar CAMPO_FECHA = 'FECHA_HECHO';\n\n// Campos por los que llegan los filtros del tablero (deben existir en todas las capas).\n// DIVISION debe ir de primera.\nvar DIMENSIONES = ['DIVISION', 'BRIGADA', 'DEPARTAMENTO', 'D_AMENAZA', 'LINEA_OPERACION'];\n\n// true = la tabla muestra sus filas en 0 cuando el filtro no tiene datos\nvar RELLENAR_CEROS = true;\n\n// Utilidades para armar los filtros SQL (no modificar)\nfunction SqlValor(v) {\n  if (TypeOf(v) == 'Number') { return Text(v); }\n  return \"'\" + Replace(Text(v), \"'\", \"''\") + \"'\";\n}\nfunction SqlLista(valores) {\n  var s = '';\n  for (var i in valores) { s += IIf(s == '', '', ',') + SqlValor(valores[i]); }\n  return '(' + s + ')';\n}\n\n// =====================================================================\n//  CONFIGURACIÓN DE LA TABLA: MINERÍA ILEGAL\n// =====================================================================\nvar ITEM_ID     = 'd0795167f05644c89cf4227d19c35b04';\nvar LAYER_ID    = 0;\nvar FILTRO_BASE = '1=1';\n\nvar INCLUIR_TOTAL       = false;     // mezcla unidades (UND, GLS, KLS)\nvar ETIQUETA_TOTAL      = 'TOTAL';\nvar INCLUIR_FILA_BLANCO = true;\n\n// Cada fila = suma de una columna\nvar FILAS = [\n  { etiqueta: 'EXCAVADORAS (UND) (MAICA)',               itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'EXCAVADORAS',         where: FILTRO_BASE },\n  { etiqueta: 'RETROEXCAVADORAS (UND) (MAICA)',          itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'RETROEXCAVADORAS',    where: FILTRO_BASE },\n  { etiqueta: 'DRAGONES (UND) (ART. FLUVIAL)',           itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'DRAGONES',            where: FILTRO_BASE },\n  { etiqueta: 'DRAGAS ARTESANALES (UND) (ART. FLUVIAL)', itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'DRAGAS_FCI',          where: FILTRO_BASE },\n  { etiqueta: 'DRAGAS TIPO BUZO (UND) (ART. FLUVIAL)',   itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'DRAGAS_TIPO_BUZO',    where: FILTRO_BASE },\n  { etiqueta: 'ACPM (GLS)',                              itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'ACPM',                where: FILTRO_BASE },\n  { etiqueta: 'MERCURIO (KLS)',                          itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'MERCURIO',            where: FILTRO_BASE },\n  { etiqueta: 'MAQUINARIA Y EQUIPO (UND)',               itemId: ITEM_ID, layerId: LAYER_ID, operacion: 'SUMA', campoSuma: 'MAQUINARIA_Y_EQUIPO', where: FILTRO_BASE }\n];\n\n// =====================================================================\n//  MOTOR: no modificar debajo de esta línea\n// =====================================================================\nvar portalObj = Portal(PORTAL_URL);\nvar SEP = '¦';\n\nfunction WhereRango(desde, hasta) {\n  return CAMPO_FECHA + \" >= DATE '\" + Text(desde) + \"-01-01' AND \" +\n         CAMPO_FECHA + \" < DATE '\"  + Text(hasta + 1) + \"-01-01'\";\n}\n\nfunction TextoDim(v) {\n  if (IsEmpty(v)) { return ''; }\n  return Text(v);\n}\n\nfunction UnirLlave(vals) {\n  var s = '';\n  for (var i in vals) { s += IIf(i == 0, '', SEP) + vals[i]; }\n  return s;\n}\n\nfunction Vacios() {\n  var v = [];\n  for (var i in DIMENSIONES) { Push(v, ''); }\n  return v;\n}\n\n// llave -> [valores de las dimensiones]\nvar grupos = {};\n\nfunction Registrar(vals) {\n  var ll = UnirLlave(vals);\n  if (!HasKey(grupos, ll)) { grupos[ll] = vals; }\n}\n\n// Suma (o conteo) de una fila en un año, agrupada por todas las dimensiones\nfunction Medir(fila, anio) {\n  var capa  = FeatureSetByPortalItem(portalObj, fila.itemId, fila.layerId, ['*'], false);\n  var where = '(' + fila.where + ') AND (' + WhereRango(anio, anio) + ')';\n  var expr  = IIf(fila.operacion == 'SUMA', fila.campoSuma, '1');\n  var est   = IIf(fila.operacion == 'SUMA', 'SUM', 'COUNT');\n  var g = GroupBy(Filter(capa, where), DIMENSIONES,\n                  [{ name: 'TOTAL_CANT', expression: expr, statistic: est }]);\n  var res = {};\n  var total = 0;\n  for (var r in g) {\n    var vals = [];\n    for (var i in DIMENSIONES) { Push(vals, TextoDim(r[DIMENSIONES[i]])); }\n    var ll = UnirLlave(vals);\n    var cant = 0;\n    if (!IsEmpty(r.TOTAL_CANT)) { cant = r.TOTAL_CANT; }\n    if (HasKey(res, ll)) { res[ll] = res[ll] + cant; } else { res[ll] = cant; }\n    total += cant;\n    Registrar(vals);\n  }\n  Console(fila.etiqueta + ' ' + Text(anio) + ': ' + Text(total));\n  return res;\n}\n\n// Grupos en cero para que la tabla nunca quede \"Sin datos\"\nvar capasVistas = {};\nfunction Rellenar(itemId, layerId) {\n  var id = itemId + '_' + Text(layerId);\n  if (HasKey(capasVistas, id)) { return; }\n  capasVistas[id] = true;\n  var capa = FeatureSetByPortalItem(portalObj, itemId, layerId, ['*'], false);\n\n  // 1) Cada valor de cada dimensión (todo el histórico de la capa)\n  for (var j in DIMENSIONES) {\n    for (var d in Distinct(capa, DIMENSIONES[j])) {\n      var x = TextoDim(d[DIMENSIONES[j]]);\n      if (x == '') { continue; }\n      var v = Vacios();\n      v[j] = x;\n      Registrar(v);\n    }\n  }\n\n  // 2) DIVISION + cada una de las otras dimensiones (periodo analizado)\n  var periodo = Filter(capa, WhereRango(ANIO_1, ANIO_2));\n  for (var j2 in DIMENSIONES) {\n    if (j2 == 0) { continue; }\n    for (var d2 in Distinct(periodo, [DIMENSIONES[0], DIMENSIONES[j2]])) {\n      var a = TextoDim(d2[DIMENSIONES[0]]);\n      var b = TextoDim(d2[DIMENSIONES[j2]]);\n      if (a == '' || b == '') { continue; }\n      var v2 = Vacios();\n      v2[0]  = a;\n      v2[j2] = b;\n      Registrar(v2);\n    }\n  }\n}\n\nfunction ValorDe(dic, ll) {\n  if (!HasKey(dic, ll)) { return 0; }\n  return dic[ll];\n}\n\n// 0 y 0 -> 0 %; 0 y >0 -> N/A; resto -> cálculo normal\nfunction Porcentaje(a1, a2) {\n  if (a1 == 0 && a2 == 0) { return 0; }\n  if (a1 == 0) { return null; }\n  return Round((a2 - a1) / a1 * 100, 0);\n}\n\nfunction Clave(n, texto) { return Text(n, '00') + '|' + texto; }\n\nvar medidas = [];\nfor (var k in FILAS) {\n  Push(medidas, { a1: Medir(FILAS[k], ANIO_1), a2: Medir(FILAS[k], ANIO_2) });\n}\nif (RELLENAR_CEROS) {\n  for (var k2 in FILAS) { Rellenar(FILAS[k2].itemId, FILAS[k2].layerId); }\n}\n\nvar nombre1 = 'A_' + Text(ANIO_1);\nvar nombre2 = 'A_' + Text(ANIO_2);\nvar features = [];\n\nfunction Agregar(vals, cv, texto, v1, v2) {\n  var attr = { CLAVE: cv, EVENTO: texto,\n               DIFERENCIA: v2 - v1, PORCENTAJE: Porcentaje(v1, v2) };\n  for (var i in DIMENSIONES) { attr[DIMENSIONES[i]] = IIf(vals[i] == '', null, vals[i]); }\n  attr[nombre1] = v1;\n  attr[nombre2] = v2;\n  Push(features, { attributes: attr });\n}\n\nfor (var ll in grupos) {\n  var vals = grupos[ll];\n  var t1 = 0;\n  var t2 = 0;\n  for (var k3 in FILAS) {\n    var v1 = ValorDe(medidas[k3].a1, ll);\n    var v2 = ValorDe(medidas[k3].a2, ll);\n    t1 += v1;\n    t2 += v2;\n    Agregar(vals, Clave(k3 + 1, FILAS[k3].etiqueta), FILAS[k3].etiqueta, v1, v2);\n  }\n  if (INCLUIR_TOTAL)       { Agregar(vals, Clave(98, ETIQUETA_TOTAL), ETIQUETA_TOTAL, t1, t2); }\n  if (INCLUIR_FILA_BLANCO) { Agregar(vals, Clave(99, ''), '', 0, 0); }\n}\nConsole('Filas generadas: ' + Text(Count(features)));\n\nvar camposSalida = [];\nfor (var i in DIMENSIONES) { Push(camposSalida, { name: DIMENSIONES[i], type: 'esriFieldTypeString' }); }\nPush(camposSalida, { name: 'CLAVE',      type: 'esriFieldTypeString' });\nPush(camposSalida, { name: 'EVENTO',     type: 'esriFieldTypeString' });\nPush(camposSalida, { name: nombre1,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: nombre2,      type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'DIFERENCIA', type: 'esriFieldTypeDouble' });\nPush(camposSalida, { name: 'PORCENTAJE', type: 'esriFieldTypeDouble' });\n\nreturn FeatureSet(Text({ fields: camposSalida, geometryType: '', features: features }));",
