"arcadeDataSourceItems": [
    {"type": "arcadeItem", "itemId": "9a8b8c82-15ed-4b71-8eb7-6b4254e523ec", "name": "Combates", "script": "// =====================================================================\n//  CONFIGURACIÓN: solo modifique este bloque\n// =====================================================================\nvar PORTAL_URL = 'https://portalgis.ejercito.mil.co/portal';\nvar ITEM_ID    = '26c3f7e3294f4d02a740f9d4ded9eb0a';\nvar LAYER_ID   = 1;\n\nvar CAMPO_CATEGORIA = 'HECHO_P';\nvar CAMPO_DIVISION  = 'DIVISION';      // campo por el que llegan los filtros\n\nvar CAMPO_FECHA = 'FECHA_HECHO';\nvar CAMPO_ANIO  = '';\n\nvar OPERACION  = 'CONTEO';             // 'CONTEO' o 'SUMA'\nvar CAMPO_SUMA = '';                   // obligatorio solo si OPERACION = 'SUMA'\n\nvar FILTRO_BASE = '1=1';\n\nvar FILAS = [\n  { etiqueta: 'POSITIVOS',      valores: ['P'] },\n  { etiqueta: 'NEGATIVOS',      valores: ['N'] },\n  { etiqueta: 'SIN RESULTADOS', valores: ['SR'] }\n];\n\nvar INCLUIR_TOTAL       = true;\nvar ETIQUETA_TOTAL      = 'TOTAL COMBATES';\nvar INCLUIR_FILA_BLANCO = true;\n\nvar ANIO_1 = 2025;\nvar ANIO_2 = 2026;\n// =====================================================================\n//  FIN DE LA CONFIGURACIÓN\n// =====================================================================\n\nvar campos = [CAMPO_CATEGORIA, CAMPO_DIVISION];\nif (!IsEmpty(CAMPO_ANIO)) { Push(campos, CAMPO_ANIO); } else { Push(campos, CAMPO_FECHA); }\nif (OPERACION == 'SUMA' && !IsEmpty(CAMPO_SUMA)) { Push(campos, CAMPO_SUMA); }\n\nvar fs = FeatureSetByPortalItem(Portal(PORTAL_URL), ITEM_ID, LAYER_ID, campos, false);\n\nfunction SqlValor(v) {\n  if (TypeOf(v) == 'Number') { return Text(v); }\n  return \"'\" + Replace(Text(v), \"'\", \"''\") + \"'\";\n}\n\nfunction WhereAnio(a) {\n  if (!IsEmpty(CAMPO_ANIO)) { return CAMPO_ANIO + ' = ' + Text(a); }\n  return CAMPO_FECHA + \" >= DATE '\" + Text(a) + \"-01-01' AND \" +\n         CAMPO_FECHA + \" < DATE '\"  + Text(a + 1) + \"-01-01'\";\n}\n\nfunction WhereFila(fila) {\n  var lista = '';\n  for (var i in fila.valores) {\n    lista += IIf(lista == '', '', ',') + SqlValor(fila.valores[i]);\n  }\n  return CAMPO_CATEGORIA + ' IN (' + lista + ')';\n}\n\n// Devuelve { 'DIV01': valor, 'DIV02': valor, ... }\nfunction MedirPorDivision(where) {\n  var expr = IIf(OPERACION == 'SUMA', CAMPO_SUMA, '1');\n  var est  = IIf(OPERACION == 'SUMA', 'SUM', 'COUNT');\n  var g = GroupBy(Filter(fs, where), [CAMPO_DIVISION], [{ name: 'VALOR', expression: expr, statistic: est }]);\n  var res = {};\n  for (var r in g) {\n    if (!IsEmpty(r[CAMPO_DIVISION])) {\n      res[Text(r[CAMPO_DIVISION])] = IIf(IsEmpty(r.VALOR), 0, r.VALOR);\n    }\n  }\n  return res;\n}\n\nfunction Valor(dic, div) { return IIf(HasKey(dic, div), dic[div], 0); }\n\n// 0 y 0 -> 0 %; 0 y >0 -> N/A; resto -> cálculo normal\nfunction Porcentaje(a1, a2) {\n  if (a1 == 0 && a2 == 0) { return 0; }\n  if (a1 == 0) { return null; }\n  return Round((a2 - a1) / a1 * 100, 0);\n}\n\nfunction Clave(n, etiqueta) { return Text(n, '00') + '|' + etiqueta; }\n\n// Lista de divisiones\nvar divisiones = [];\nfor (var d in Distinct(Filter(fs, FILTRO_BASE), CAMPO_DIVISION)) {\n  if (!IsEmpty(d[CAMPO_DIVISION])) { Push(divisiones, Text(d[CAMPO_DIVISION])); }\n}\n\n// Consultas: 2 por fila (una por año), agrupadas por división\nvar medidas = [];\nfor (var k in FILAS) {\n  var base = '(' + FILTRO_BASE + ') AND (' + WhereFila(FILAS[k]) + ')';\n  Push(medidas, {\n    a1: MedirPorDivision(base + ' AND ' + WhereAnio(ANIO_1)),\n    a2: MedirPorDivision(base + ' AND ' + WhereAnio(ANIO_2))\n  });\n}\n\nvar nombre1 = 'A_' + Text(ANIO_1);\nvar nombre2 = 'A_' + Text(ANIO_2);\nvar features = [];\n\nfunction Agregar(div, clave, etiqueta, v1, v2) {\n  var attr = { DIVISION: div, CLAVE: clave, EVENTO: etiqueta,\n               DIFERENCIA: v2 - v1, PORCENTAJE: Porcentaje(v1, v2) };\n  attr[nombre1] = v1;\n  attr[nombre2] = v2;\n  Push(features, { attributes: attr });\n}\n\nfor (var x in divisiones) {\n  var div = divisiones[x];\n  var t1 = 0;\n  var t2 = 0;\n  for (var k in FILAS) {\n    var v1 = Valor(medidas[k].a1, div);\n    var v2 = Valor(medidas[k].a2, div);\n    t1 += v1;\n    t2 += v2;\n    Agregar(div, Clave(k + 1, FILAS[k].etiqueta), FILAS[k].etiqueta, v1, v2);\n  }\n  if (INCLUIR_TOTAL)       { Agregar(div, Clave(98, ETIQUETA_TOTAL), ETIQUETA_TOTAL, t1, t2); }\n  if (INCLUIR_FILA_BLANCO) { Agregar(div, Clave(99, ''), '', 0, 0); }\n}\n\nvar salida = {\n  fields: [\n    { name: 'DIVISION',   type: 'esriFieldTypeString' },\n    { name: 'CLAVE',      type: 'esriFieldTypeString' },\n    { name: 'EVENTO',     type: 'esriFieldTypeString' },\n    { name: nombre1,      type: 'esriFieldTypeDouble' },\n    { name: nombre2,      type: 'esriFieldTypeDouble' },\n    { name: 'DIFERENCIA', type: 'esriFieldTypeDouble' },\n    { name: 'PORCENTAJE', type: 'esriFieldTypeDouble' }\n  ],\n  geometryType: '',\n  features: features\n};\n\nreturn FeatureSet(Text(salida));", "refreshInterval": 180}
],
