        "script": "// =====================================================================\n//  CONFIGURACIÓN: solo modifique este bloque\n// =====================================================================\nvar PORTAL_URL = 'https://portalgis.ejercito.mil.co/portal';\n\nvar ANIO_1 = 2025;\nvar ANIO_2 = 2026;\n\nvar INCLUIR_TOTAL       = true;\nvar ETIQUETA_TOTAL      = 'TOTAL';\nvar INCLUIR_FILA_BLANCO = true;\n\nvar AMENAZAS_MDOM = [\n  'GAO-ELN',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO CAPARROS',\n  'GAO COMUNEROS DEL SUR',\n  'FARC',\n  'GAO-r SM Facción Iván Márquez',\n  'DELINCUENCIA',\n  'ERG',\n  'GAO PELUSOS',\n  'GDO',\n  'EPL',\n  'GAO',\n  'NARCOTRÁFICO',\n  'GAO - Residual Disidencias FARC',\n  'ERP',\n  'GAO-r EMC Facción Iván Mordisco',\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO-RESIDUAL',\n  'BACRIM',\n  'GAO-r SM-CNEB Facción Walter Mendoza'\n];\n\nvar AMENAZAS_CAPTURAS = [\n  'DELINCUENCIA COMÚN',\n  'GAO-ELN',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO COMUNEROS DEL SUR',\n  'GAO-r SM Facción Iván Márquez',\n  'DELINCUENCIA',\n  'GDO',\n  'GAO',\n  'NARCOTRÁFICO',\n  'GAO-r EMC Facción Iván Mordisco',\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO - Residual Disidencias FARC',\n  'GAO-r SM-CNEB Facción Walter Mendoza',\n  'Delincuencia Organizada Transnacional',\n  'GAO-RESIDUAL'\n];\n\nvar AMENAZAS_SOMETIDOS = [\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO-ELN',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO COMUNEROS DEL SUR',\n  'GAO-r SM Facción Iván Márquez',\n  'GDO',\n  'GAO-r EMC Facción Iván Mordisco',\n  'GAO - Residual Disidencias FARC',\n  'GAO-r SM-CNEB Facción Walter Mendoza',\n  'GAO-RESIDUAL'\n];\n\nvar AMENAZAS_RME = [\n  'GAO COMUNEROS DEL SUR',\n  'Autodefensas Conquistadoras de la Sierra',\n  'GAO-ELN',\n  'GAO Clan del Glolfo (Autodenominado Ejército Gaitanista de Colombia - EGC)',\n  'GAO-r EMC EMBYF Facción Calarcá',\n  'GAO-r SM Facción Iván Márquez',\n  'DELINCUENCIA',\n  'GDO',\n  'NARCOTRÁFICO',\n  'GAO - Residual Disidencias FARC',\n  'GAO-r EMC Facción Iván Mordisco',\n  'GAO-RESIDUAL',\n  'Delincuencia Organizada Transnacional',\n  'GAO-r SM-CNEB Facción Walter Mendoza'\n];\n\nvar SUBTIPOS_PERSONAS = ['TERRORISTAS', 'NARCOTRAFICANTES', 'DELINCUENTES'];\n\nvar FUENTES = [\n  {\n    etiqueta: 'M. D. O. M', itemId: '3df1e55fdf6345c4a7fc4c61cfbe9f8b', layerId: 0,\n    campoDivision: 'DIVISION', campoFecha: 'FECHA_HECHO',\n    operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    filtros: [\n      { campo: 'PROPIAS_TROPAS', op: 'IN',     valores: ['N'] },\n      { campo: 'D_AMENAZA',      op: 'IN',     valores: AMENAZAS_MDOM },\n      { campo: 'CLASE',          op: 'IN',     valores: ['GAO-R', 'BDSN', 'FARC', 'DELINCUENCIA COMÚN', 'ELN', 'ERG', 'GAO', 'GDO', 'EPL', 'NARCOTRAFICO', 'ERP', 'GAO-RESIDUAL'] },\n      { campo: 'SUBTIPO',        op: 'NOT IN', valores: ['CANINOS', 'SEMOVIENTES', 'SOLDADOS', 'SUBOFICIALES', 'OFICIALES'] }\n    ]\n  },\n  {\n    etiqueta: 'Capturas', itemId: '03d84fbdf68e4f2fbb67cbd3341830f1', layerId: 2,\n    campoDivision: 'DIVISION', campoFecha: 'FECHA_HECHO',\n    operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    filtros: [\n      { campo: 'PROPIAS_TROPAS', op: 'IN', valores: ['N'] },\n      { campo: 'TIPO',           op: 'IN', valores: ['PERSONAS'] },\n      { campo: 'SUBTIPO',        op: 'IN', valores: SUBTIPOS_PERSONAS },\n      { campo: 'D_AMENAZA',      op: 'IN', valores: AMENAZAS_CAPTURAS }\n    ]\n  },\n  {\n    etiqueta: 'Sometidos', itemId: '3b82c922e2ed4385a9680a1d4bf4144f', layerId: 0,\n    campoDivision: 'DIVISION', campoFecha: 'FECHA_HECHO',\n    operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    filtros: [\n      { campo: 'PROPIAS_TROPAS', op: 'IN', valores: ['N'] },\n      { campo: 'TIPO',           op: 'IN', valores: ['PERSONAS'] },\n      { campo: 'SUBTIPO',        op: 'IN', valores: SUBTIPOS_PERSONAS },\n      { campo: 'D_AMENAZA',      op: 'IN', valores: AMENAZAS_SOMETIDOS }\n    ]\n  },\n  {\n    etiqueta: 'R M E', itemId: '1df585d1105c4a6eb2e1c4ec8c132042', layerId: 0,\n    campoDivision: 'DIVISION', campoFecha: 'FECHA_HECHO',\n    operacion: 'SUMA', campoSuma: 'CANTIDAD',\n    filtros: [\n      { campo: 'PROPIAS_TROPAS', op: 'IN', valores: ['N'] },\n      { campo: 'TIPO',           op: 'IN', valores: ['PERSONAS'] },\n      { campo: 'SUBTIPO',        op: 'IN', valores: SUBTIPOS_PERSONAS },\n      { campo: 'D_AMENAZA',      op: 'IN', valores: AMENAZAS_RME }\n    ]\n  }\n];\n// =====================================================================\n//  FIN DE LA CONFIGURACIÓN\n// =====================================================================\n\nvar portalObj = Portal(PORTAL_URL);\n\nfunction SqlValor(v) {\n  if (TypeOf(v) == 'Number') { return Text(v); }\n  return \"'\" + Replace(Text(v), \"'\", \"''\") + \"'\";\n}\n\nfunction WhereFiltros(lista) {\n  var w = '1=1';\n  for (var i in lista) {\n    var regla = lista[i];\n    var vals = '';\n    for (var j in regla.valores) {\n      vals += IIf(vals == '', '', ',') + SqlValor(regla.valores[j]);\n    }\n    w += ' AND ' + regla.campo + ' ' + regla.op + ' (' + vals + ')';\n  }\n  return w;\n}\n\nfunction WhereAnio(campoF, a) {\n  return campoF + \" >= DATE '\" + Text(a) + \"-01-01' AND \" +\n         campoF + \" < DATE '\"  + Text(a + 1) + \"-01-01'\";\n}\n\nfunction MedirFuente(capa, fuente, anio) {\n  var where = '(' + WhereFiltros(fuente.filtros) + ') AND (' + WhereAnio(fuente.campoFecha, anio) + ')';\n  var expr  = IIf(fuente.operacion == 'SUMA', fuente.campoSuma, '1');\n  var est   = IIf(fuente.operacion == 'SUMA', 'SUM', 'COUNT');\n  var g = GroupBy(Filter(capa, where), [fuente.campoDivision],\n                  [{ name: 'VALOR', expression: expr, statistic: est }]);\n  var res = {};\n  for (var r in g) {\n    var dv = r[fuente.campoDivision];\n    if (!IsEmpty(dv)) { res[Text(dv)] = IIf(IsEmpty(r.VALOR), 0, r.VALOR); }\n  }\n  return res;\n}\n\nfunction ValorDe(dic, clave) { return IIf(HasKey(dic, clave), dic[clave], 0); }\n\nfunction Porcentaje(a1, a2) {\n  if (a1 == 0 && a2 == 0) { return 0; }\n  if (a1 == 0) { return null; }\n  return Round((a2 - a1) / a1 * 100, 0);\n}\n\nfunction Clave(n, texto) { return Text(n, '00') + '|' + texto; }\n\nvar medidas = [];\nvar setDivisiones = {};\nfor (var k in FUENTES) {\n  var fuente = FUENTES[k];\n  var campos = [fuente.campoDivision, fuente.campoFecha];\n  if (fuente.operacion == 'SUMA') { Push(campos, fuente.campoSuma); }\n  for (var q in fuente.filtros) { Push(campos, fuente.filtros[q].campo); }\n\n  var capa = FeatureSetByPortalItem(portalObj, fuente.itemId, fuente.layerId, campos, false);\n  var m = { a1: MedirFuente(capa, fuente, ANIO_1), a2: MedirFuente(capa, fuente, ANIO_2) };\n  Push(medidas, m);\n\n  for (var d1 in m.a1) { setDivisiones[d1] = true; }\n  for (var d2 in m.a2) { setDivisiones[d2] = true; }\n}\n\nvar nombre1 = 'A_' + Text(ANIO_1);\nvar nombre2 = 'A_' + Text(ANIO_2);\nvar features = [];\n\nfunction Agregar(dv, clave, texto, v1, v2) {\n  var attr = { DIVISION: dv, CLAVE: clave, EVENTO: texto,\n               DIFERENCIA: v2 - v1, PORCENTAJE: Porcentaje(v1, v2) };\n  attr[nombre1] = v1;\n  attr[nombre2] = v2;\n  Push(features, { attributes: attr });\n}\n\nfor (var dv in setDivisiones) {\n  var t1 = 0;\n  var t2 = 0;\n  for (var k in FUENTES) {\n    var v1 = ValorDe(medidas[k].a1, dv);\n    var v2 = ValorDe(medidas[k].a2, dv);\n    t1 += v1;\n    t2 += v2;\n    Agregar(dv, Clave(k + 1, FUENTES[k].etiqueta), FUENTES[k].etiqueta, v1, v2);\n  }\n  if (INCLUIR_TOTAL)       { Agregar(dv, Clave(98, ETIQUETA_TOTAL), ETIQUETA_TOTAL, t1, t2); }\n  if (INCLUIR_FILA_BLANCO) { Agregar(dv, Clave(99, ''), '', 0, 0); }\n}\n\nvar salida = {\n  fields: [\n    { name: 'DIVISION',   type: 'esriFieldTypeString' },\n    { name: 'CLAVE',      type: 'esriFieldTypeString' },\n    { name: 'EVENTO',     type: 'esriFieldTypeString' },\n    { name: nombre1,      type: 'esriFieldTypeDouble' },\n    { name: nombre2,      type: 'esriFieldTypeDouble' },\n    { name: 'DIFERENCIA', type: 'esriFieldTypeDouble' },\n    { name: 'PORCENTAJE', type: 'esriFieldTypeDouble' }\n  ],\n  geometryType: '',\n  features: features\n};\n\nreturn FeatureSet(Text(salida));",
        "refreshInterval": 180
    }
